#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    int T ;
    cin >> T ;
    while(T--){
        int N,M;
        cin >> N >> M ;
        if(N <= M){
            cout << 0 << endl ;
        }
        else{
            cout << N - M << endl ;
        }
    }
    return 0;
}
